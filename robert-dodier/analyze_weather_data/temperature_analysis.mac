load ("year_utilities.mac");
load ("partition_data.mac");
load ("mutate.mac");
load ("select.mac");

/* Analyses:
 *
 * 1. Coverage
 *   1a. Compute coverage year by year for each column, and look for runs of 90% or greater.
 *   1b. Find the intersection of columns which have 90%+ coverage for all stations
 *       (not necessarily in the same years).
 *
 * 2. Temperature
 *   2a. Average max and average min by multi-year periods.
 *       1 year periods, 10 year periods including 2020, 30 year periods including 2010, 100 year periods including 2000.
 *   2b. Exceedance for max and min temperature
 *       min > 70 F, for 1, 10, 30, and 100 year periods, as above, reported as number of days per year.
 *       max > 90 F, for 1, 10, 30, and 100 year periods, as above, reported as number of days per year.
 *   2c. Distribution of temperature difference between max and min.
 *       (max - min) > 20 F, 30 F, or 40 F for 1, 10, 30, and 100 year periods, as above, reported as number of days per year.
 *
 * 3. Precipitation
 *   3a. Total precipitation for for 1, 10, 30, and 100 year periods, as above.
 *   3b. Exceedance for precipitation
 *       precipitation > 0 inch for 1, 10, 30, and 100 year periods, as above, reported as number of days per year.
 *       precipitation > 1 inch for 1, 10, 30, and 100 year periods, as above, reported as number of days per year.
 *   3c. Total precipitation by months or seasons for 1, 10, 30, and 100 year periods.
 */

load ("operatingsystem");

if (input: getenv ("INPUT")) = false
    then error ("temperature_analysis.mac: environment variable INPUT not specified, with no default.");

/* I suppose ATTRIBUTES columns could maybe possibly be present for any data column;
 * the ones listed here are just the ones which are present in the existing CSVs.
 */

df: data_frame_from_file (input, nonnumeric_columns = [ "STATION", "NAME", "DATE", "DAPR_ATTRIBUTES", "MDPR_ATTRIBUTES", "PRCP_ATTRIBUTES", "SNOW_ATTRIBUTES", "SNWD_ATTRIBUTES", "WESD_ATTRIBUTES", "WESF_ATTRIBUTES" ]);

df1: mutate (df by ("DATE_parsed" = lambda([l], map (parse_timedate, l)) of "DATE"));

df1a: mutate (df1 by ("DATE_year" = lambda([l], map (year, l)) of "DATE_parsed"));

floor10 (x) := 10 * floor (x / 10);
floor30 (x) := 1980 + 30 * floor ((x - 1980) / 30);
floor100 (x) := 100 * floor (x / 100);

defstruct (month_day (month, day));

L: [
    "DATE_month_day" = lambda ([l], map (month_day, map (month, l), map (day_of_month, l))) of "DATE_parsed",
    "DATE_month" = lambda ([l], map (month, l)) of "DATE_parsed",
    "DATE_decade" = lambda ([l], map (floor10, l)) of "DATE_year",
    "DATE_30year" = lambda ([l], map (floor30, l)) of "DATE_year",
    "DATE_century" = lambda ([l], map (floor100, l)) of "DATE_year"
];

df1b: mutate (df1a by L);

df1b_by_STATION: group (df1b by "STATION");

/* Assume there is exactly one value, be it missing or not, per day.
 * Assess coverage as the proportion of nonmissing values per nominal year.
 */

simple_annual_coverage (grouping_days, l) :=
    block ([n_not_missing: lsum (if x # false then 1 else 0, x, l)],
           n_not_missing / grouping_days);

clean (l) := sublist (l, lambda ([x], x # false));

clean_mean (l) := block ([n], l: clean (l), n: length (l), if n > 0 then float (lsum (x, x, l) / n));

defstruct (min_max (min, max));

clean_range (l) := block ([n], l: clean (l), min_max (lmin (l), lmax (l)));

/* For analysis of 1 year to multiple years, filter out years for which daily data coverage is less than 90%.
 * Implement that by grouping by years, filtering out years with insufficient coverage,
 * then ungrouping and regrouping for the specified number of years.
 * The last ungrouping/regrouping step is a no-op when the analysis period is one year
 * and can therefore be omitted.
 */

FOO: block ([foo, h: make_array (hashed, 1)],
            /* should group(... by ...) recognize nested data frame and carry out map_over_df itself? */
            foo: map_over_df (lambda ([df], group (df by "DATE_year")), df1b_by_STATION),
            /* this nested looping seems to call for a built-in operation for filtering ... */
            for [[y], a] in foo@data
                do block ([h: make_array (hashed, 1)],
                          for [[z], b] in a@data
                              /* coverage of TMAX is almost certainly the same as for TMIN,
                               * but compute both and look at the smaller one, on general principle.
                               */
                              do block ([TMIN_coverage: simple_annual_coverage (365.2425, b@data["TMIN"]),
                                         TMAX_coverage: simple_annual_coverage (365.2425, b@data["TMAX"])],
                                        if (c: min (TMIN_coverage, TMAX_coverage)) >= 0.9 then h[z]: b
                                            else print ("temperature_analysis: for station", y, "omit year", z, "(simple annual coverage =", c, ")")),
                          nested_data_frame (a@names, h),
                          unnest_nested_data_frame (%%),
                          /* this next bit with arraysetapply is kind of terrible;
                           * but foo@ata[y]: %% and (foo@data)[y]: %% both trigger "cannot assign to foo@data[y]".
                           */
                          arraysetapply (foo@data, [y], %%)),
            foo);

temperature_analysis_1 (df, grouping_field, f) :=
    block ([df1, df2, df3],
          df1: group (select ([grouping_field, "TMIN", "TMAX"] from df) by grouping_field),
          /* need to inject f into lambda expression since otherwise f gets mixed up with an identically-named variable;
           * lexical scope would prevent the mix-up, if I understand correctly what the problem is.
           */
          df2: map_over_df (buildq ([f], lambda ([df], aggregate (df by f))), df1),
          df3: unnest_nested_data_frame (df2));

temperature_analysis_2 (df, outer_grouping_field, inner_grouping_field, f) :=
    block ([df1, df2, df3, df4, df5],
          df1: group (select ([outer_grouping_field, inner_grouping_field, "TMIN", "TMAX"] from df) by outer_grouping_field),
          df2: group (select ([inner_grouping_field, "TMIN", "TMAX"] from df1) by inner_grouping_field),
          df3: aggregate (df2 by f));

foo (df) := matrix_from_data_frame (map_over_df (unnest_nested_data_frame, df));

fpprintprec: 6;

temperature_df_1: map_over_df (lambda ([df], temperature_analysis_1 (df, "DATE_year", clean_mean)), FOO);
temperature_df_10: map_over_df (lambda ([df], temperature_analysis_1 (df, "DATE_decade", clean_mean)), FOO);
temperature_df_30: map_over_df (lambda ([df], temperature_analysis_1 (df, "DATE_30year", clean_mean)), FOO);
temperature_df_100: map_over_df (lambda ([df], temperature_analysis_1 (df, "DATE_century", clean_mean)), FOO);

foo (temperature_df_1);
foo (temperature_df_10);
foo (temperature_df_30);
foo (temperature_df_100);

temperature_df_1a: map_over_df (lambda ([df], temperature_analysis_2 (df, "DATE_month", "DATE_year", clean_mean)), FOO);
temperature_df_10a: map_over_df (lambda ([df], temperature_analysis_2 (df, "DATE_month", "DATE_decade", clean_mean)), FOO);
temperature_df_30a: map_over_df (lambda ([df], temperature_analysis_2 (df, "DATE_month", "DATE_30year", clean_mean)), FOO);
temperature_df_100a: map_over_df (lambda ([df], temperature_analysis_2 (df, "DATE_month", "DATE_century", clean_mean)), FOO);

foo (temperature_df_1a);
foo (temperature_df_10a);
foo (temperature_df_30a);
foo (temperature_df_100a);

label_pattern: regex_compile ("^%[a-z]([0-9][0-9]*)$");
extract_label_number (s) := (regex_match (label_pattern, string (s)), if %% # false then %%[2]);

(input_labels: labels (%i),
 input_labels_numbers: map (parse_string, map (extract_label_number, input_labels)),
 output_labels: labels (%o),
 output_labels_numbers: map (parse_string, map (extract_label_number, output_labels)),
 input_and_output_numbers: listify (intersection (setify (input_labels_numbers), setify (output_labels_numbers))),
 input_labels_1: map (lambda ([n], concat (%i, n)), input_and_output_numbers),
 input_exprs_1: map (?meval, input_labels_1),
 output_labels_1: map (lambda ([n], concat (%o, n)), input_and_output_numbers),
 output_times_1: apply (time, output_labels_1),
 transpose (matrix (input_labels_1, map (lambda ([e], if atom (e) then e else op (e)), input_exprs_1), output_times_1)));

